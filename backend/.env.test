# --- Server ---
NODE_ENV=test
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://hq:hq_password@localhost:5432/healthcare_queue_test?schema=public

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- Clinic ---
# IANA time zone used to interpret doctor schedules ("09:00" etc.)
CLINIC_TIMEZONE=UTC

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
