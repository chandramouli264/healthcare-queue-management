generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTIONIST
  DOCTOR
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// CONFIRMED, IN_CONSULTATION and COMPLETED are "active" statuses: they occupy
/// the doctor's time and are covered by the no-overlap exclusion constraint.
enum AppointmentStatus {
  CONFIRMED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueEntryStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  role         Role     @default(PATIENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor  Doctor?
  patient Patient?

  @@index([role])
  @@map("users")
}

model Doctor {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  specialization       String
  qualifications       String
  experienceYears      Int      @default(0) @map("experience_years")
  consultationDuration Int      @default(30) @map("consultation_duration")
  consultationFee      Decimal  @default(0) @map("consultation_fee") @db.Decimal(10, 2)
  contactPhone         String?  @map("contact_phone")
  contactEmail         String?  @map("contact_email")
  roomNumber           String?  @map("room_number")
  bio                  String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules     DoctorSchedule[]
  timeOff       DoctorTimeOff[]
  appointments  Appointment[]
  queues        Queue[]
  prescriptions Prescription[]

  @@index([specialization])
  @@map("doctors")
}

model Patient {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  gender                Gender?
  bloodGroup            String?   @map("blood_group")
  address               String?
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  allergies             String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  queueEntries  QueueEntry[]
  prescriptions Prescription[]

  @@map("patients")
}

/// Weekly recurring working hours. Times are "HH:mm" in the clinic time zone.
model DoctorSchedule {
  id           String   @id @default(uuid()) @db.Uuid
  doctorId     String   @map("doctor_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week") /// 0 = Sunday ... 6 = Saturday
  startTime    String   @map("start_time") @db.VarChar(5)
  endTime      String   @map("end_time") @db.VarChar(5)
  breakStart   String?  @map("break_start") @db.VarChar(5)
  breakEnd     String?  @map("break_end") @db.VarChar(5)
  slotDuration Int      @map("slot_duration")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

/// One-off unavailable periods (leave, meetings, ...).
model DoctorTimeOff {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  startTime DateTime @map("start_time") @db.Timestamptz(6)
  endTime   DateTime @map("end_time") @db.Timestamptz(6)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startTime])
  @@map("doctor_time_off")
}

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  reference    String            @unique
  patientId    String            @map("patient_id") @db.Uuid
  doctorId     String            @map("doctor_id") @db.Uuid
  startTime    DateTime          @map("start_time") @db.Timestamptz(6)
  endTime      DateTime          @map("end_time") @db.Timestamptz(6)
  status       AppointmentStatus @default(CONFIRMED)
  reason       String?
  notes        String?
  cancelReason String?           @map("cancel_reason")
  cancelledAt  DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  queueEntry    QueueEntry?
  prescriptions Prescription[]

  @@index([doctorId, startTime])
  @@index([patientId, startTime])
  @@index([status])
  @@map("appointments")
}

/// One queue per doctor per clinic day.
model Queue {
  id         String   @id @default(uuid()) @db.Uuid
  doctorId   String   @map("doctor_id") @db.Uuid
  queueDate  DateTime @map("queue_date") @db.Date
  lastToken  Int      @default(0) @map("last_token")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor  Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  entries QueueEntry[]

  @@unique([doctorId, queueDate])
  @@map("queues")
}

model QueueEntry {
  id            String           @id @default(uuid()) @db.Uuid
  queueId       String           @map("queue_id") @db.Uuid
  appointmentId String           @unique @map("appointment_id") @db.Uuid
  patientId     String           @map("patient_id") @db.Uuid
  tokenNumber   Int              @map("token_number")
  status        QueueEntryStatus @default(WAITING)
  calledAt      DateTime?        @map("called_at") @db.Timestamptz(6)
  startedAt     DateTime?        @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  queue       Queue       @relation(fields: [queueId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([queueId, tokenNumber])
  @@index([queueId, status])
  @@map("queue_entries")
}

model Prescription {
  id            String   @id @default(uuid()) @db.Uuid
  reference     String   @unique
  appointmentId String   @map("appointment_id") @db.Uuid
  doctorId      String   @map("doctor_id") @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  diagnosis     String
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  doctor      Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items       PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String @id @default(uuid()) @db.Uuid
  prescriptionId String @map("prescription_id") @db.Uuid
  medicineName   String @map("medicine_name")
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}
