# Base URL of the API. Leave as /api to use the Vite dev proxy.
VITE_API_URL=/api
# Socket.IO server origin. Leave empty to use the same origin (Vite proxy).
VITE_SOCKET_URL=
# Where the Vite dev server proxies /api and /socket.io
VITE_PROXY_TARGET=http://localhost:4000
# Time zone used to display appointment times (should match backend CLINIC_TIMEZONE)
VITE_CLINIC_TIMEZONE=Asia/Kolkata
